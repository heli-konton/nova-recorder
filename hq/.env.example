# Copy to hq/.env and fill in. Keep this file out of git.

# Must match `upload.api_key` in every Pi's /etc/nova-recorder/config.yaml
INGEST_API_KEY=change-me

INGEST_PORT=8770
DATA_DIR=/data

# Hugging Face token with access to pyannote/speaker-diarization-3.1
# (accept the gated-model terms on HF first, then create a token)
HF_TOKEN=

# Anthropic API key used for the daily notes/todos/summary write-up
ANTHROPIC_API_KEY=

WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
DIARIZE=true

# how often (seconds) the processor checks for a finished day to process
POLL_INTERVAL_S=60
